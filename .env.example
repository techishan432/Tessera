# ──────────────────────────────────────────────────────────────────────────────
# Tessera — environment (TESTNET ONLY — never put mainnet values here)
# Copy to .env.local and fill in. Contract IDs are set by scripts after
# Phase 1 deploy; org issuer keys come from your testnet identities.
# ──────────────────────────────────────────────────────────────────────────────

# ── Soroban / Stellar (testnet) ───────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Contract IDs on testnet (filled after deploy)
CREDENTIAL_CONTRACT_ID=
ISSUER_REGISTRY_CONTRACT_ID=
# Operator/sponsor account: pays tx fees for minting and funds sponsored
# zero-XLM recipient accounts. TESTNET KEY ONLY.
ISSUER_SECRET_KEY=
# Org issuer signing keys — JSON map of org name -> testnet secret key.
# Each org signs its own mints; the registry must list each address.
ORG_ISSUER_KEYS={}
# Shared key the organizer dashboard sends (x-organizer-key header)
ORGANIZER_API_KEY=

# ── IPFS metadata (Pinata) ────────────────────────────────────────────────────
# Badge metadata JSON is pinned to IPFS; only the CID goes on-chain.
PINATA_API_KEY=
PINATA_API_SECRET=

# ── AI verification (OpenAI-compatible, lib/ai-verify) ───────────────────────
# Provider flag:
#   LLM_PROVIDER=qwen (default) | openai | anthropic | custom
# qwen uses DashScope's OpenAI-compatible endpoint; "custom" + LLM_BASE_URL
# works with any /chat/completions gateway (CN endpoint, vLLM, LiteLLM, Ollama…).
LLM_PROVIDER=qwen
LLM_API_KEY=
# Model id — any model your endpoint serves (qwen3-32b by default)
LLM_MODEL=qwen3-32b
# Endpoint override (optional for qwen/openai; required for custom)
LLM_BASE_URL=
# Confidence (0–1) at/above which a claim auto-approves; below → manual review
VERIFY_AUTO_APPROVE_THRESHOLD=0.8
